# Copie este arquivo para .env e preencha os valores da API financeira.
# O JSON de credenciais deve permanecer em uma única linha.
GOOGLE_SHEETS_CREDENTIALS_JSON={}
GOOGLE_SHEETS_SPREADSHEET_ID=
