# Copie este arquivo para .env e preencha os valores da API financeira.
# O JSON de credenciais deve permanecer em uma única linha.
GOOGLE_SHEETS_CREDENTIALS_JSON={}
GOOGLE_SHEETS_SPREADSHEET_ID=
# Este arquivo permanece disponível apenas para configurações adicionais locais.
# Os caminhos de implantação usados pela máquina servidora estão definidos no docker-compose.yml.
# Nunca envie o Client Secret por chat nem publique o arquivo .env.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_ID=
PLUGGY_BRADESCO_CAMILA_ITEM_ID=
PLUGGY_BRADESCO_DIEGO_CLIENT_ID=
PLUGGY_BRADESCO_DIEGO_CLIENT_SECRET=
PLUGGY_BRADESCO_DIEGO_ITEM_ID=
